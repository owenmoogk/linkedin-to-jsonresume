{
    "name": "linkedin-to-json-resume-exporter",
    "version": "3.3.0",
    "description": "Browser extension (Firefox / Chrome) that exports your open LinkedIn profile to JSON Resume",
    "private": true,
    "main": "src/main.js",
    "scripts": {
        "build": "node ./build-scripts/prep-dirs.js && webpack --config webpack.prod.js && node ./build-scripts/prep-browserext.js",
        "build:dev": "node ./build-scripts/prep-dirs.js && webpack --config webpack.dev.js && node ./build-scripts/prep-browserext.js",
        "package": "npm run build && node ./build-scripts/package-browserext.js",
        "type-check": "tsc --noEmit"
    },
    "author": {
        "name": "Joshua Tzucker",
        "url": "https://joshuatz.com/?utm_source=package"
    },
    "license": "MIT",
    "devDependencies": {
        "@babel/cli": "^7.27.2",
        "@babel/core": "^7.27.4",
        "@babel/plugin-transform-runtime": "^7.27.4",
        "@babel/preset-env": "^7.27.2",
        "@babel/runtime": "^7.27.4",
        "@types/archiver": "^6.0.3",
        "@types/chrome": "0.0.326",
        "@types/fs-extra": "^11.0.4",
        "archiver": "^7.0.1",
        "babel-loader": "^10.0.0",
        "fs-extra": "^11.3.0",
        "prettier": "^3.5.3",
        "typescript": "^5.8.3",
        "webpack": "^5.99.9",
        "webpack-cli": "^6.0.1"
    },
    "babel": {
        "plugins": [
            "@babel/transform-runtime"
        ],
        "presets": [
            [
                "@babel/preset-env",
                {
                    "targets": {
                        "browsers": "defaults"
                    }
                }
            ]
        ]
    },
    "dependencies": {
        "@dan/vcards": "^2.10.0"
    }
}
